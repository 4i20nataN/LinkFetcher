# LinkFetcher License Server — copie p/ server/.env e preencha. NUNCA commitar.
# Ver server/README.md (passo a passo com a conta do Mercado Pago).
#
# ATENÇÃO — dois backends, dois jogos de variáveis:
#   [Node legado] server/server.mjs lê tudo abaixo via process.env.
#   [Worker oficial] server/worker/ lê via env: MP_ACCESS_TOKEN,
#     MP_WEBHOOK_SECRET, LICENSE_PRIVATE_JWK, BREVO_API_KEY, SMTP_FROM,
#     ADMIN_PASSWORD (+ PLANS_JSON opcional) vão como `wrangler secret put`
#     (NUNCA em [vars]); PRICE/PLAN_DAYS/BASE_URL ficam em [vars].

# Mercado Pago — dashboard do vendedor (Suas integrações → Credenciais):
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Dashboard → Webhooks (evento de pagamento na URL /api/webhook/mercadopago):
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
# URL pública HTTPS do servidor (webhook + QR). Local: http://localhost:8787
BASE_URL=https://seu-servidor
# Oferta (tem que bater com PRO_PLAN no app):
PRICE=9.99
PLAN_DAYS=30
PORT=8787

# Emissão de chaves: JWK da privada em linha única COM aspas simples
# (exigido pelo shell e pelo EnvironmentFile do systemd). Gere com:
# node scripts/export-jwk.mjs  → cole a saída entre as aspas abaixo.
LICENSE_PRIVATE_JWK='{"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}'

# E-mail da chave (opcional — sem isso a entrega é só pelo poll no app):
# [Node legado] SMTP_HOST/USER/PASS abaixo. [Worker oficial] usa a API do
# Brevo: `wrangler secret put BREVO_API_KEY` + `wrangler secret put SMTP_FROM`
# (remetente verificado no Brevo). SMTP_* abaixo é ignorado pelo Worker.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Persistência (disco persistente no deploy):
DB_FILE=./server/data/db.json
# Stub p/ teste local da UI (nunca em produção):
# MP_API_BASE=http://localhost:9999
